import math
import os
import matplotlib.pyplot as plt
import numpy as np

# --- 1. ТРАНСЦЕНДЕНТНА ФУНКЦІЯ ---
def f(x):
    return math.exp(x) - 5*x + 1

def f_prime(x):
    return math.exp(x) - 5

def f_double_prime(x):
    return math.exp(x)

# --- 2. ТАБУЛЯЦІЯ ТА ГРАФІК ---
def perform_tabulation(a, b, h=0.1):
    x_vals = np.arange(a, b + h, h)
    y_vals = [f(val) for val in x_vals]
    
    with open("tabulation.txt", "w", encoding="utf-8") as file:
        file.write("x\t\tf(x)\n")
        for x, y in zip(x_vals, y_vals):
            file.write(f"{x:.2f}\t{y:.6f}\n")
    
    plt.figure(figsize=(10, 5))
    plt.plot(x_vals, y_vals, label='F(x) = exp(x) - 5x + 1')
    plt.axhline(0, color='red', linestyle='--')
    plt.title("Табуляція функції")
    plt.grid(True)
    plt.legend()
    plt.show()
    return x_vals, y_vals

# --- 3. МЕТОДИ УТОЧНЕННЯ  ---

def simple_iteration(x0, eps=1e-10):
    tau = -0.1 if f_prime(x0) > 0 else 0.1
    x_curr = x0
    for i in range(1, 1001):
        x_next = x_curr + tau * f(x_curr)
        if abs(f(x_next)) < eps and abs(x_next - x_curr) < eps:
            return x_next, i
        x_curr = x_next
    return x_curr, 1000

def newton_method(x0, eps=1e-10):
    x_curr = x0
    for i in range(1, 101):
        x_next = x_curr - f(x_curr) / f_prime(x_curr)
        if abs(f(x_next)) < eps and abs(x_next - x_curr) < eps:
            return x_next, i
        x_curr = x_next
    return x_curr, 100

def chebyshev_method(x0, eps=1e-10):
    x_curr = x0
    for i in range(1, 101):
        fn, dfn, ddfn = f(x_curr), f_prime(x_curr), f_double_prime(x_curr)
        x_next = x_curr - fn/dfn - 0.5 * (fn**2 * ddfn) / (dfn**3)
        if abs(f(x_next)) < eps and abs(x_next - x_curr) < eps:
            return x_next, i
        x_curr = x_next
    return x_curr, 100

def chord_method(x_prev, x_curr, eps=1e-10):
    for i in range(1, 101):
        f_curr, f_prev = f(x_curr), f(x_prev)
        x_next = x_curr - f_curr * (x_curr - x_prev) / (f_curr - f_prev)
        if abs(f(x_next)) < eps and abs(x_next - x_curr) < eps:
            return x_next, i
        x_prev, x_curr = x_curr, x_next
    return x_curr, 100

# --- 4. АЛГЕБРАЇЧНІ РІВНЯНЯ ---

def horner_newton(a, x0, eps=1e-10):
    m = len(a) - 1
    x_curr = x0
    for i in range(1, 101):
        b = [0]*(m+1)
        b[m] = a[m]
        for j in range(m-1, -1, -1):
            b[j] = a[j] + x_curr * b[j+1]
        
        c = [0]*(m+1)
        c[m] = b[m]
        for j in range(m-1, 0, -1):
            c[j] = b[j] + x_curr * c[j+1]
        
        x_next = x_curr - b[0]/c[1]
        if abs(x_next - x_curr) < eps:
            return x_next, i
        x_curr = x_next
    return x_curr, 100

def lin_method(a, alpha0, beta0, eps=1e-10):
    m = len(a) - 1
    for i in range(1, 501):
        p, q = -2*alpha0, alpha0**2 + beta0**2
        b = [0]*(m+1)
        b[m] = a[m]
        b[m-1] = a[m-1] - p*b[m]
        for j in range(m-2, 1, -1):
            b[j] = a[j] - p*b[j+1] - q*b[j+2]
        
        q1 = a[0]/b[2]
        p1 = (a[1]*b[2] - a[0]*b[3])/(b[2]**2)
        
        a1 = -p1/2
        det = q1 - a1**2
        b1 = math.sqrt(abs(det))
        
        if abs(a1 - alpha0) < eps and abs(b1 - beta0) < eps:
            return (a1, b1), i
        alpha0, beta0 = a1, b1
    return (alpha0, beta0), 500

# --- ВИКОНАННЯ ВСІХ ПУНКТІВ ---
if __name__ == "__main__":
    print("--- Етап 1: Табуляція ---")
    perform_tabulation(0, 4)
    
    roots_approx = [0.2, 2.5] 

    print("\n--- Етап 2: Уточнення коренів (eps=10^-10) ---")
    for x0 in roots_approx:
        print(f"\nКоренева зона біля x={x0}:")
        print(f"Проста ітерація: {simple_iteration(x0)}")
        print(f"Метод Ньютона:   {newton_method(x0)}")
        print(f"Метод Чебишева:  {chebyshev_method(x0)}")
        print(f"Метод хорд:      {chord_method(x0-0.1, x0)}")

    print("\n--- Етап 3: Алгебраїчне рівняння ---")
    with open("coeffs.txt", "w") as f_out:
        f_out.write("-2 4 -3 1")
    
    with open("coeffs.txt", "r") as f_in:
        poly_coeffs = [float(x) for x in f_in.read().split()]

    px = np.linspace(0, 2, 100)
    py = [poly_coeffs[3]*x**3 + poly_coeffs[2]*x**2 + poly_coeffs[1]*x + poly_coeffs[0] for x in px]
    
    plt.figure(figsize=(10, 5))
    plt.plot(px, py, label='x^3 - 3x^2 + 4x - 2')
    plt.axhline(0, color='black')
    plt.title("Графік алгебраїчного рівняння")
    plt.grid(True)
    plt.legend()
    plt.show()

    print(f"Дійсний корінь (Горнер): {horner_newton(poly_coeffs, 1.5)}")
    print(f"Комплексні корені (Лін): {lin_method(poly_coeffs, 0.5, 0.5)}")
